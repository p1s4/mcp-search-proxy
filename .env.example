# Copy to .env and fill in your values. Never commit .env.
# One comma-separated entry per upstream, in order.
UPSTREAM_URLS=http://upstream1:4000/mcp,http://upstream2:8101/mcp

# Bearer tokens, positional against UPSTREAM_URLS (empty entry = no auth).
# Example: first upstream needs a token, second does not (note trailing comma).
UPSTREAM_TOKENS=sk-your-token-here,

# Legacy single-token fallback: sent only to URLs containing "litellm".
# Leave empty unless you use a LiteLLM aggregator.
LITELLM_MASTER_KEY=

# Safety-net TTL for background refresh (seconds). 0 = explicit/unknown-tool only.
CATALOG_TTL_SEC=1800
