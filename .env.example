# .env — mcp-search-proxy
# Copy this file to .env and set the real values. NEVER commit the key.

# ------------------------------------------------------------------ upstreams
# Recommended: coupled url|token pairs (token optional after |).
# Tokens must not contain | or ,  (entries split on comma, pair on FIRST |).
# If UPSTREAMS is set, UPSTREAM_URLS / UPSTREAM_TOKENS below are IGNORED.
# UPSTREAMS=https://opendata.cat/api/mcp,https://foo.bar/mcp|sk-abc123

# Legacy: comma-separated upstream MCP URLs (Streamable HTTP).
# First URL wins on tool-name collisions (fail-closed merge).
UPSTREAM_URLS=http://litellm:4000/mcp

# Legacy: positional Bearer tokens against UPSTREAM_URLS (empty entry = no auth).
# Example with 2 upstreams, second without auth: "sk-abc123,"
# UPSTREAM_TOKENS=

# Legacy single-token fallback: sent ONLY to URLs containing "litellm".
# Also the default key for the optional semantic notes (ENRICH_API_KEY empty).
LITELLM_MASTER_KEY=INSERISCI_QUI_LITELLM_MASTER_KEY

# ---------------------------------------------------------------- 1.1.0 (optional)
# Logical groups for the optional `group` param of mcp_search/mcp_describe.
# Syntax: name=pattern[,pattern];name2=...
# The pattern is fnmatch-ed against the tool name AND the source prefix, so
# membership follows the upstreams by itself — no list to maintain.
# GROUPS=workspace=Google_Workspace*,file_bridge,NotebookLm,Clickup;audit=audit*,scan*,browser*,chrome_devtools;dev=github,Context7,wsc_mcp,n8n_mcp,tika

# Manual purpose pins: source=text;source2=text. Win over generated notes.
# Use ONLY for the exceptions that must not drift.
# 1.1.1: a pin replaces the PURPOSE only. Obligations (MUST/NEVER) always come
# from the deterministic layer, so a pin cannot erase them.
# PURPOSES=my_source=Web search + crawl of any URL. Prefer this over curl for reading a web page.

# Semantic notes: any OpenAI-compatible endpoint.
# ENRICH_BASE_URL must include the API version.
# ENRICH_API_KEY empty -> falls back to LITELLM_MASTER_KEY.
# If ENRICH_BASE_URL or ENRICH_MODEL are empty the feature is OFF (1.0.x behaviour).
# ENRICH_BASE_URL=http://litellm:4000/v1
# ENRICH_MODEL=gemini-lite
# ENRICH_API_KEY=
# ENRICH_TIMEOUT=60
# ENRICH_CONCURRENCY=4

# ---------------------------------------------------------------- 1.1.1
# Obligations layer: no variable. Always active, cannot be disabled.
# The upstream's imperative rules (MUST, NEVER, 'start with X first',
# 'before building ... confirm', 'run `cmd`') are extracted verbatim and
# published in a separate section of the instructions, below the catalog.
